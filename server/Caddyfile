{$DOMAIN} {
	# WebSocket of the relay (the game connects to wss://DOMAIN/ws), and its health check
	# (handle blocks: otherwise "respond" would run before "reverse_proxy", in Caddy's directive order)
	handle /ws* {
		reverse_proxy relay:8090
	}
	handle /health {
		reverse_proxy relay:8090
	}
	handle {
		respond "php-wasm-network relay" 200
	}
}
