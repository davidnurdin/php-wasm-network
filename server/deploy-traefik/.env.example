# nom du serveur (DNS vers la machine) ; DOMAIN_ALIAS : un ancien nom encore servi (sinon : le même que DOMAIN)
DOMAIN=net.example.org
DOMAIN_ALIAS=net.example.org
# machine derrière un NAT : adresse publique et adresse privée (sans NAT : les deux pareilles)
PUBLIC_IP=203.0.113.10
PRIVATE_IP=10.0.0.10
TURN_PORT=3480
TURN_MIN_PORT=49300
TURN_MAX_PORT=49340
# le nom donné aux navigateurs pour le TURN : il doit mener directement à la machine (pas de proxy Cloudflare)
TURN_HOST=turn.example.org
# openssl rand -hex 32
TURN_SECRET=
# le site (sonicGameSite) et sa base MariaDB : openssl rand -hex 32 pour chacun
SITE_APP_SECRET=
SITE_MERCURE_SECRET=
SITE_DB_PASSWORD=
SITE_DB_ROOT_PASSWORD=
